<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BluePhone.App"
             Name="파란전화기"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <!-- 기본 색 (테마를 고르면 ChatLook 이 덮어씀) -->
        <SolidColorBrush x:Key="Accent" Color="#1D5BF0"/>
        <SolidColorBrush x:Key="AccentFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentHover" Color="#174DD4"/>
        <SolidColorBrush x:Key="AccentPressed" Color="#1340B3"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#EAF0FE"/>
        <SolidColorBrush x:Key="AccentSoftHover" Color="#DCE6FD"/>
        <SolidColorBrush x:Key="Canvas" Color="#F5F6F8"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Hover" Color="#EEF0F3"/>
        <SolidColorBrush x:Key="Pressed" Color="#E4E7EC"/>
        <SolidColorBrush x:Key="Line" Color="#E4E7EC"/>
        <SolidColorBrush x:Key="LineStrong" Color="#D2D6DD"/>
        <SolidColorBrush x:Key="Ink" Color="#15181D"/>
        <SolidColorBrush x:Key="Ink2" Color="#4A5160"/>
        <SolidColorBrush x:Key="Muted" Color="#7B8291"/>
        <SolidColorBrush x:Key="Faint" Color="#A3A9B4"/>
        <SolidColorBrush x:Key="Danger" Color="#D93A3F"/>
        <SolidColorBrush x:Key="DangerSoft" Color="#FDECEC"/>
        <SolidColorBrush x:Key="Warn" Color="#B7791F"/>
        <SolidColorBrush x:Key="LinkFg" Color="#1D5BF0"/>
        <SolidColorBrush x:Key="Ct.Bg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Ct.Panel" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Ct.Text" Color="#15181D"/>
        <SolidColorBrush x:Key="Ct.Sub" Color="#6B7280"/>
        <SolidColorBrush x:Key="Ct.Line" Color="#E6E8EC"/>
        <SolidColorBrush x:Key="Ct.In" Color="#F1F3F6"/>
        <SolidColorBrush x:Key="Ct.InText" Color="#15181D"/>
        <SolidColorBrush x:Key="Ct.Out" Color="#1D5BF0"/>
        <SolidColorBrush x:Key="Ct.OutText" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Ct.InputBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Ct.InputLine" Color="#D5D9E0"/>
        <SolidColorBrush x:Key="Ct.Meta" Color="#A3A9B4"/>
        <SolidColorBrush x:Key="Ct.FileBg" Color="#14000000"/>
        <SolidColorBrush x:Key="Ct.Overlay" Color="#EEFFFFFF"/>
        <FontFamily x:Key="Ct.Font">Apple SD Gothic Neo, Malgun Gothic, Segoe UI</FontFamily>
        <x:Double x:Key="Ct.Size">13.5</x:Double>
        <FontFamily x:Key="UI">Apple SD Gothic Neo, Malgun Gothic, Segoe UI</FontFamily>
        <!-- Fluent 컨트롤의 강조색도 앱 색으로 -->
        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#661D5BF0"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource UI}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Window.app">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- ───────── 버튼 ───────── -->
        <Style Selector="Button.ghost, Button.outline, Button.primary, Button.danger, Button.icon, Button.link">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="cp" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ Border#bd, Button.outline:pointerover /template/ Border#bd, Button.icon:pointerover /template/ Border#bd">
            <Setter Property="Background" Value="{DynamicResource Hover}"/>
        </Style>
        <Style Selector="Button.ghost:pressed /template/ Border#bd, Button.outline:pressed /template/ Border#bd, Button.icon:pressed /template/ Border#bd">
            <Setter Property="Background" Value="{DynamicResource Pressed}"/>
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ Border#bd">
            <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ Border#bd">
            <Setter Property="Background" Value="{DynamicResource AccentPressed}"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource Danger}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ Border#bd">
            <Setter Property="Opacity" Value="0.88"/>
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="Button.link:pointerover">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <!-- ───────── 입력칸 ───────── -->
        <Style Selector="TextBox.field, AutoCompleteBox TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Muted}"/>
        </Style>
        <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox.field:focus">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="TextBox.field /template/ TextBlock#PART_Watermark, TextBox.field /template/ TextBlock#PART_FloatingWatermark">
            <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        </Style>
        <!-- 테두리 없는 입력칸 (대화 · 쪽지 본문) -->
        <Style Selector="TextBox.bare">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.bare:focus, TextBox.bare:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="TextBox.bare /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        </Style>
        <Style Selector="TextBox.code, TextBox.code:pointerover, TextBox.code:focus">
            <Setter Property="Foreground" Value="{Binding $parent[ContentControl].Foreground}"/>
        </Style>
        <Style Selector="TextBox.code /template/ Border#PART_BorderElement, TextBox.code:pointerover /template/ Border#PART_BorderElement, TextBox.code:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- ───────── 칩 · 탭 ───────── -->
        <Style Selector="ToggleButton.filter, ToggleButton.chip">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="bd" CornerRadius="13" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" Padding="10,2">
                        <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.chip">
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <Style Selector="ToggleButton.chip /template/ Border#bd">
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style Selector="ToggleButton.filter:pointerover /template/ Border#bd, ToggleButton.chip:pointerover /template/ Border#bd">
            <Setter Property="Background" Value="{DynamicResource Hover}"/>
        </Style>
        <Style Selector="ToggleButton.filter:checked /template/ Border#bd">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.filter:checked">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="ToggleButton.chip:checked /template/ Border#bd">
            <Setter Property="Background" Value="{DynamicResource DangerSoft}"/>
            <Setter Property="BorderBrush" Value="#F2B8BA"/>
        </Style>
        <Style Selector="ToggleButton.chip:checked">
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        </Style>

        <Style Selector="RadioButton.tab">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent" Margin="0,0,18,0">
                        <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                        <Border Name="bar" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Ink}" CornerRadius="1" IsVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.tab:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
        </Style>
        <Style Selector="RadioButton.tab:checked">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style Selector="RadioButton.tab:checked /template/ Border#bar">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- ───────── 스위치 ───────── -->
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
        </Style>
        <Style Selector="CheckBox.switch">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent" ColumnDefinitions="*,Auto">
                        <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Name="track" Grid.Column="1" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource LineStrong}" VerticalAlignment="Center">
                            <Ellipse Name="knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.switch:checked /template/ Border#track">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="CheckBox.switch:checked /template/ Ellipse#knob">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- ───────── 목록 ───────── -->
        <Style Selector="ListBox.flat">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.flat ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="ListBox.flat ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ListBox.flat ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Hover}"/>
        </Style>
        <Style Selector="ListBox.flat ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>
        <Style Selector="ListBox.flat ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftHover}"/>
        </Style>
        <Style Selector="ListBox.flat ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
        </Style>
        <Style Selector="ListBox.flat ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Pressed}"/>
        </Style>
        <Style Selector="ListBox.flat ListBoxItem.header">
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="ListBox.flat ListBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>

        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource Line}"/>
        </Style>
        <Style Selector="MenuFlyoutPresenter, ContextMenu">
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </Application.Styles>
</Application>
