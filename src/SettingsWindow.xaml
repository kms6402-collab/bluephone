<Window x:Class="BluePhone.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Width="460" Height="640" MinWidth="400" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,26,0,12"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,11"/>
        </Style>
        <Style x:Key="Help" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource ChromeClose}" Content="&#xE8BB;" VerticalAlignment="Top" Click="Cancel_Click"/>
            <TextBlock Text="설정" FontSize="15" FontWeight="SemiBold" Margin="24,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,20,24">
            <StackPanel>
                <!-- profile -->
                <TextBlock Text="프로필" Style="{StaticResource Section}" Margin="0,8,0,12"/>
                <Grid Margin="0,0,0,16" AllowDrop="True" Drop="Photo_Drop" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="68" Height="68" Cursor="Hand" MouseLeftButtonUp="PickPhoto_Click" ToolTip="사진 선택">
                        <Ellipse x:Name="PhotoBg"/>
                        <TextBlock x:Name="PhotoInitial" Foreground="White" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse><Ellipse.Fill><ImageBrush x:Name="PhotoBrush" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="&#xE722;" FontFamily="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource Ink2}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Outline}" Content="사진 선택" Height="30" Click="PickPhoto_Click"/>
                            <Button x:Name="RemovePhotoBtn" Style="{StaticResource Ghost}" Content="삭제" Height="30" Margin="6,0,0,0" Click="RemovePhoto_Click"
                                    Foreground="{StaticResource Danger}"/>
                        </StackPanel>
                        <TextBlock Text="JPG · PNG · BMP · GIF. 가운데를 정사각형으로 맞춰 동료들에게 보여집니다." Style="{StaticResource Help}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="이름" Style="{StaticResource Label}"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource Field}" MaxLength="30"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="부서" Style="{StaticResource Label}"/>
                        <TextBox x:Name="DeptBox" Style="{StaticResource Field}" Tag="예: 영업2팀" MaxLength="30"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="상태 메시지" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                <TextBox x:Name="NoteBox" Style="{StaticResource Field}" Tag="동료 목록에 이름 아래로 표시됩니다" MaxLength="60"/>

                <!-- notifications -->
                <TextBlock Text="알림" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Row}" BorderThickness="0,1,0,1">
                    <CheckBox x:Name="SoundChk" Style="{StaticResource Switch}">
                        <StackPanel>
                            <TextBlock Text="알림음"/>
                            <TextBlock Text="긴급 쪽지는 다른 소리로 알립니다" Style="{StaticResource Help}"/>
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}">
                    <CheckBox x:Name="NoFocusChk" Style="{StaticResource Switch}">
                        <StackPanel>
                            <TextBlock Text="작업 중에는 쪽지 창이 입력을 가로채지 않음"/>
                            <TextBlock Text="쪽지 창은 화면 오른쪽 아래에 뜨고, 클릭해야 활성화됩니다" Style="{StaticResource Help}"/>
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="받은 쪽지 창 자동으로 닫기"/>
                            <TextBlock Text="정한 시간이 지나면 창이 사라지고 쪽지는 쪽지함에 '안 읽음'으로 남습니다. 마우스를 올리거나 답장 중이면 기다리고, 긴급 쪽지는 닫지 않습니다." Style="{StaticResource Help}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel x:Name="AutoClosePanel" Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton GroupName="AutoClose" Style="{StaticResource FilterChip}" Tag="0" Margin="0,0,6,0"><TextBlock Text="닫지 않음" FontSize="12"/></RadioButton>
                            <RadioButton GroupName="AutoClose" Style="{StaticResource FilterChip}" Tag="10" Margin="0,0,6,0"><TextBlock Text="10초" FontSize="12"/></RadioButton>
                            <RadioButton GroupName="AutoClose" Style="{StaticResource FilterChip}" Tag="30" Margin="0,0,6,0"><TextBlock Text="30초" FontSize="12"/></RadioButton>
                            <RadioButton GroupName="AutoClose" Style="{StaticResource FilterChip}" Tag="60"><TextBlock Text="1분" FontSize="12"/></RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="알림 개인정보 보호"/>
                            <TextBlock Text="쪽지·대화 알림이 뜰 때 화면에 보여 줄 범위입니다. 가려진 알림은 누르거나 '내용 보기'를 눌러야 보이고, 그 전에는 읽음으로 처리하지 않습니다." Style="{StaticResource Help}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <WrapPanel x:Name="PrivacyPanel" Margin="0,10,0,0">
                            <RadioButton GroupName="Privacy" Style="{StaticResource FilterChip}" Tag="0" Margin="0,0,6,6"><TextBlock Text="보낸 사람, 메시지 내용 모두 표시" FontSize="12"/></RadioButton>
                            <RadioButton GroupName="Privacy" Style="{StaticResource FilterChip}" Tag="1" Margin="0,0,6,6"><TextBlock Text="보낸 사람만 표시" FontSize="12"/></RadioButton>
                            <RadioButton GroupName="Privacy" Style="{StaticResource FilterChip}" Tag="2" Margin="0,0,6,6"><TextBlock Text="보낸 사람, 메시지 내용 모두 숨기기" FontSize="12"/></RadioButton>
                        </WrapPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <CheckBox x:Name="ReceiptChk" Style="{StaticResource Switch}">
                        <StackPanel>
                            <TextBlock Text="읽음 확인 보내기"/>
                            <TextBlock Text="쪽지를 열면 보낸 사람에게 '읽음'으로 표시됩니다" Style="{StaticResource Help}"/>
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}">
                    <CheckBox x:Name="EnterChk" Style="{StaticResource Switch}">
                        <StackPanel>
                            <TextBlock Text="대화 창에서 Enter 로 보내기"/>
                            <TextBlock Text="끄면 Ctrl+Enter 로 보내고, Enter 는 줄바꿈이 됩니다" Style="{StaticResource Help}"/>
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}">
                    <CheckBox x:Name="HotkeyChk" Style="{StaticResource Switch}">
                        <StackPanel>
                            <TextBlock Text="화면 캡처 단축키 Ctrl+Alt+S"/>
                            <TextBlock x:Name="HotkeyHelp" Text="어디서든 영역을 드래그해 바로 쪽지에 첨부합니다" Style="{StaticResource Help}"/>
                        </StackPanel>
                    </CheckBox>
                </Border>

                <!-- away -->
                <TextBlock Text="자리 비움" Style="{StaticResource Section}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="AwayBox" Style="{StaticResource Field}" Width="64" HorizontalContentAlignment="Center"
                             PreviewTextInput="Digits_PreviewTextInput" MaxLength="3"/>
                    <TextBlock Text="분 동안 입력이 없으면 자리 비움으로 전환" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource Ink2}"/>
                </StackPanel>
                <TextBlock Text="0 으로 두면 자동 전환하지 않습니다" Style="{StaticResource Help}" Margin="0,6,0,0"/>
                <TextBlock Text="자동응답" Style="{StaticResource Label}" Margin="0,16,0,6"/>
                <TextBox x:Name="AutoReplyBox" Style="{StaticResource Field}" Tag="비워 두면 사용 안 함" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="56" VerticalContentAlignment="Top" Padding="9,7" MaxLength="300"/>
                <TextBlock Text="'대화 가능'이 아닐 때 받은 쪽지에 이 내용으로 자동 답장합니다" Style="{StaticResource Help}" Margin="0,6,0,0"/>

                <!-- startup -->
                <TextBlock Text="시작" Style="{StaticResource Section}"/>
                <Border Style="{StaticResource Row}" BorderThickness="0,1,0,1">
                    <CheckBox x:Name="AutoStartChk" Style="{StaticResource Switch}">
                        <StackPanel>
                            <TextBlock Text="Windows 시작 시 실행"/>
                            <TextBlock x:Name="AutoStartHelp" Style="{StaticResource Help}"/>
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}">
                    <CheckBox x:Name="HiddenChk" Style="{StaticResource Switch}">
                        <TextBlock Text="실행할 때 창 없이 트레이에서 시작"/>
                    </CheckBox>
                </Border>

                <!-- files -->
                <TextBlock Text="받은 파일" Style="{StaticResource Section}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Outline}" Content="변경" Margin="8,0,0,0" Click="PickDir_Click"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Outline}" Content="열기" Margin="8,0,0,0" Click="OpenDir_Click"/>
                    <TextBox x:Name="DirBox" Style="{StaticResource Field}" IsReadOnly="True"/>
                </DockPanel>
                <TextBlock Text="Shift 를 누른 채 '받기'를 누르면 위치를 직접 고를 수 있습니다" Style="{StaticResource Help}" Margin="0,6,0,0"/>

                <!-- network -->
                <TextBlock Text="네트워크" Style="{StaticResource Section}"/>
                <DockPanel>
                    <TextBlock Text="포트" VerticalAlignment="Center" Width="40" Foreground="{StaticResource Ink2}"/>
                    <TextBox x:Name="PortBox" Style="{StaticResource Field}" Width="80" HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                             PreviewTextInput="Digits_PreviewTextInput" MaxLength="5"/>
                    <TextBlock Text="모든 PC가 같은 포트를 써야 합니다 (UDP·TCP)" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock Text="직접 추가할 PC" Style="{StaticResource Label}" Margin="0,16,0,6"/>
                <TextBox x:Name="HostsBox" Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="74"
                         VerticalContentAlignment="Top" Padding="9,7" FontFamily="Cascadia Mono, Consolas, Malgun Gothic" FontSize="12.5"
                         Tag="한 줄에 하나씩 · 192.168.10.25 또는 PC 이름" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="라우터 너머 다른 대역처럼 자동으로 찾지 못하는 PC를 등록합니다" Style="{StaticResource Help}" Margin="0,6,0,0"/>
                <TextBlock x:Name="MyIps" Style="{StaticResource Help}" Margin="0,10,0,0"/>

                <!-- about -->
                <TextBlock Text="정보" Style="{StaticResource Section}"/>
                <Border Background="{StaticResource Canvas}" CornerRadius="8" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ContentControl ContentTemplate="{StaticResource LogoMark}" Focusable="False"/>
                            <TextBlock Text="파란전화기" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="ExeText" Style="{StaticResource Help}" Margin="0,10,0,0"/>
                        <CheckBox x:Name="AutoUpdateChk" Style="{StaticResource Switch}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="자동 업데이트"/>
                                <TextBlock Text="GitHub에 새 버전이 올라오면 받아 두고 변경 사항과 함께 알려 줍니다" Style="{StaticResource Help}"/>
                            </StackPanel>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="CheckBtn" Style="{StaticResource Primary}" Content="업데이트 확인" Height="28" Click="CheckUpdate_Click"/>
                            <Button Style="{StaticResource Outline}" Content="변경 이력" Height="28" Margin="8,0,0,0" Click="Changelog_Click"/>
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource Outline}" Content="데이터 폴더" Height="28" Click="DataDir_Click"/>
                            <Button Style="{StaticResource Outline}" Content="쪽지함 비우기" Height="28" Margin="8,0,0,0" Click="ClearHistory_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Outline}" Content="취소" MinWidth="76" Click="Cancel_Click" IsCancel="True"/>
                <Button Style="{StaticResource Primary}" Content="저장" MinWidth="76" Margin="8,0,0,0" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
