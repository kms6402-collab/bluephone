<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BluePhone</AssemblyName>
    <RootNamespace>BluePhone</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <!-- FileDescription 을 비워 두면 작업 관리자가 실제 exe 파일명을 표시한다 -->
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <!-- 버전: 로컬 빌드 기본값. GitHub Actions 는 태그(v2.1.0)에서 -p:Version 으로 덮어씀 -->
    <Version>2.2.7</Version>
    <Company>BluePhone</Company>
    <Product>파란전화기</Product>
    <Copyright>© 2026 파란전화기</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="emoji\*.png" LogicalName="emoji/%(Filename).png" />
    <EmbeddedResource Include="emoji\list.txt" LogicalName="emoji/list.txt" />
  </ItemGroup>
</Project>
