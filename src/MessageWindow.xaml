<Window x:Class="BluePhone.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="쪽지" Width="384" SizeToContent="Height" MinWidth="320" MinHeight="180" ShowInTaskbar="True">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide"/>
        </Grid.RenderTransform>

        <Border x:Name="UrgentLine" Height="3" Background="{StaticResource Danger}" Visibility="Collapsed"/>

        <!-- header (drag area) -->
        <Grid Grid.Row="1" Height="64">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="38" Height="38" Margin="18,0,12,0" VerticalAlignment="Center">
                <Ellipse x:Name="Avatar"/>
                <TextBlock x:Name="Initial" Foreground="White" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse><Ellipse.Fill><ImageBrush x:Name="Photo" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="FromName" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                    <Border x:Name="Tag1" CornerRadius="4" Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="Tag1Text" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SubLine" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource ChromeClose}" Content="&#xE8BB;" VerticalAlignment="Top" Click="Close_Click" ToolTip="닫기 (Esc)"/>
        </Grid>

        <!-- body -->
        <TextBox x:Name="Body" Grid.Row="2" Style="{StaticResource BareArea}" IsReadOnly="True" Margin="18,2,12,16" MinHeight="44" MaxHeight="320"
                 IsReadOnlyCaretVisible="False" FontSize="14"/>

        <!-- files -->
        <ItemsControl x:Name="FileList" Grid.Row="3" Margin="12,0,12,8" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Margin="6,0,6,6" Padding="10,6,6,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Glyph}" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding State}" Style="{StaticResource Caption}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="3" Margin="0,4,0,0" BorderThickness="0"
                                             Background="{StaticResource Line}" Foreground="{StaticResource Accent}" x:Name="bar" Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="act" Style="{StaticResource Outline}" Height="28" Padding="10,0" Margin="8,0,0,0" Tag="{Binding}" Click="FileAction_Click"
                                        Content="받기"/>
                                <Button x:Name="folder" Style="{StaticResource Outline}" Height="28" Width="30" Padding="0" Margin="6,0,0,0" Tag="{Binding}" Click="FileFolder_Click"
                                        Visibility="Collapsed" ToolTip="폴더에서 보기">
                                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource Glyph}" FontSize="13" Foreground="{StaticResource Ink2}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="받는 중">
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="act" Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="완료">
                            <Setter TargetName="act" Property="Content" Value="열기"/>
                            <Setter TargetName="folder" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="실패">
                            <Setter TargetName="act" Property="Content" Value="다시"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="보낸 파일">
                            <Setter TargetName="act" Property="Content" Value="위치"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- quick reply -->
        <Border x:Name="ReplyPane" Grid.Row="4" Visibility="Collapsed" Margin="18,0,18,10">
            <TextBox x:Name="ReplyBox" Style="{StaticResource Field}" Tag="답장 입력 · Ctrl+Enter 로 보내기" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="64" MaxHeight="120" VerticalContentAlignment="Top" Padding="9,7" VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="ReplyBox_PreviewKeyDown"/>
        </Border>

        <!-- footer -->
        <Border Grid.Row="5" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,10,12,12" Background="{StaticResource Surface}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource Icon}" Content="&#xE8C8;" ToolTip="내용 복사" Click="Copy_Click"/>
                <Button x:Name="ReplyBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Height="34" Padding="18,0" MinWidth="84" Click="Reply_Click">
                    <TextBlock x:Name="ReplyText" Text="답장"/>
                </Button>
                <Button x:Name="CloseBtn" DockPanel.Dock="Right" Style="{StaticResource Outline}" Height="34" Padding="16,0" Margin="0,0,8,0" Content="닫기" Click="Close_Click"/>
                <TextBlock x:Name="Footnote" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"
                           MouseLeftButtonUp="Footnote_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
