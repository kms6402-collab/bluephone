<Window x:Class="BluePhone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BluePhone"
        Title="파란전화기" Width="340" Height="640" MinWidth="300" MinHeight="460">
    <Window.Resources>
        <local:BoolToVis x:Key="Vis"/>
        <local:BoolToVis x:Key="NotVis" Invert="True"/>

        <DataTemplate x:Key="PeerTpl" DataType="{x:Type local:Peer}">
            <Grid Height="48" Background="Transparent" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="900"
                  Opacity="{Binding Opacity}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Fill="{Binding AvatarBrush}"/>
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse><Ellipse.Fill><ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                    <Ellipse Width="12" Height="12" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"/>
                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding RealNameHint, Mode=OneWay, StringFormat='  {0}'}" Foreground="{StaticResource Faint}" FontSize="12"/>
                    </TextBlock>
                    <TextBlock Text="{Binding SubText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>
                <Ellipse Grid.Column="2" Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,14,0"
                         Visibility="{Binding HasUnread, Converter={StaticResource Vis}}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MsgTpl" DataType="{x:Type local:ChatMessage}">
            <Grid Background="Transparent" Margin="0,0,0,0" MinHeight="58">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" VerticalAlignment="Top" Margin="0,11,0,0">
                    <Ellipse Fill="{Binding AvatarBrush}"/>
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse><Ellipse.Fill><ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                </Grid>
                <StackPanel Grid.Column="1" Margin="0,10,12,10">
                    <Grid>
                        <TextBlock Text="{Binding Who}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,64,0"/>
                        <TextBlock Text="{Binding TimeText}" HorizontalAlignment="Right" Foreground="{StaticResource Faint}" FontSize="11.5"/>
                    </Grid>
                    <DockPanel Margin="0,2,0,0">
                        <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Fill="{StaticResource Accent}" Margin="8,0,2,0"
                                 Visibility="{Binding IsUnread, Converter={StaticResource Vis}}"/>
                        <TextBlock x:Name="me" DockPanel.Dock="Left" Text="나:" Foreground="{StaticResource Faint}" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Preview, Mode=OneWay}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Ink2}"/>
                    </DockPanel>
                    <TextBlock x:Name="meta" Text="{Binding Meta}" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="0,3,0,0"
                               Visibility="{Binding Meta, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Outgoing}" Value="False">
                    <Setter TargetName="me" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                    <Setter TargetName="meta" Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="GroupHeader" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="18,12,0,4">
                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding ItemCount}" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <ItemsPresenter/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- title bar -->
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                <Button x:Name="MoreBtn" Style="{StaticResource Chrome}" FontSize="13" ToolTip="메뉴" Click="More_Click">
                    <Grid>
                        <TextBlock Text="&#xE712;"/>
                        <Ellipse x:Name="MoreDot" Width="7" Height="7" Fill="{StaticResource Danger}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-3,-5,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource Chrome}" Content="&#xE921;" ToolTip="최소화" Click="Min_Click"/>
                <Button Style="{StaticResource ChromeClose}" Content="&#xE8BB;" ToolTip="트레이로 숨기기" Click="Close_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center">
                <ContentControl ContentTemplate="{StaticResource LogoMark}" Focusable="False"/>
                <TextBlock Text="파란전화기" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionLabel" Foreground="{StaticResource Faint}" FontSize="11.5" Margin="7,1,0,0" VerticalAlignment="Center"/>
                <Border x:Name="UpdateBadge" Background="{StaticResource Accent}" CornerRadius="10" Padding="8,2,9,2" Margin="8,0,0,0" VerticalAlignment="Center"
                        Visibility="Collapsed" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonUp="UpdateBadge_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource Glyph}" Foreground="White" FontSize="10" VerticalAlignment="Center" Margin="0,1,5,0"/>
                        <TextBlock x:Name="UpdateBadgeText" Text="업데이트" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Border/>
        </DockPanel>

        <!-- me -->
        <Grid Grid.Row="1" Margin="16,6,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Width="40" Height="40">
                <Ellipse x:Name="MyAvatar"/>
                <TextBlock x:Name="MyInitial" Foreground="White" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse><Ellipse.Fill><ImageBrush x:Name="MyPhoto" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="MyName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MyDept" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            </StackPanel>
            <Button x:Name="StatusBtn" Grid.Column="2" Style="{StaticResource Outline}" Height="30" Padding="10,0,8,0" Click="Status_Click"
                    VerticalAlignment="Center" ToolTip="상태 변경">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="MyDot" Width="8" Height="8" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MyStatus" Margin="7,0,6,0" FontSize="12.5" VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Glyph}" FontSize="9" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- search -->
        <Grid Grid.Row="2" Margin="14,0,14,10">
            <TextBox x:Name="Search" Style="{StaticResource Field}" Tag="이름, 부서, IP 검색" Padding="30,0,28,0" Height="34"
                     Background="{StaticResource Canvas}" BorderBrush="Transparent" TextChanged="Search_Changed"/>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource Glyph}" FontSize="13" Foreground="{StaticResource Muted}"
                       VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
            <Button x:Name="ClearSearch" Style="{StaticResource Icon}" Width="26" Height="26" FontSize="10" Content="&#xE894;" HorizontalAlignment="Right"
                    Margin="0,0,4,0" Visibility="Collapsed" Click="ClearSearch_Click" ToolTip="지우기"/>
        </Grid>

        <!-- tabs -->
        <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,0,0,0">
            <StackPanel Orientation="Horizontal" Height="34">
                <RadioButton x:Name="TabPeers" Style="{StaticResource Tab}" IsChecked="True" Checked="Tab_Changed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="동료" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PeerCount" Margin="5,0,0,0" Foreground="{StaticResource Faint}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabHistory" Style="{StaticResource Tab}" Checked="Tab_Changed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="쪽지함" FontWeight="SemiBold"/>
                        <Border x:Name="UnreadBadge" Background="{StaticResource Accent}" CornerRadius="8" MinWidth="16" Height="16" Padding="5,0" Margin="6,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="UnreadText" Foreground="White" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- peers -->
        <Grid Grid.Row="4" x:Name="PeersPane">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <WrapPanel x:Name="GroupBar" Margin="14,8,10,0"/>
            <ListBox Grid.Row="1" x:Name="PeerList" IsSynchronizedWithCurrentItem="False" Style="{StaticResource FlatList}" ItemTemplate="{StaticResource PeerTpl}" SelectionMode="Extended"
                     Padding="0,0,0,8" MouseDoubleClick="PeerList_DoubleClick" KeyDown="PeerList_KeyDown" SelectionChanged="PeerList_SelectionChanged"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                <ListBox.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource GroupHeader}"/>
                </ListBox.GroupStyle>
                <ListBox.ContextMenu>
                    <ContextMenu Opened="PeerMenu_Opened">
                        <MenuItem x:Name="PmChat" Header="대화 보기" Click="PmChat_Click" FontWeight="SemiBold" InputGestureText="더블클릭"/>
                        <MenuItem x:Name="PmSend" Header="쪽지 보내기" Click="PmSend_Click" InputGestureText="Enter"/>
                        <Separator/>
                        <MenuItem x:Name="PmFav" Header="즐겨찾기에 추가" Click="PmFav_Click"/>
                        <MenuItem x:Name="PmGroup" Header="그룹에 추가"/>
                        <MenuItem x:Name="PmAlias" Header="별명 지정…" Click="PmAlias_Click"/>
                        <MenuItem x:Name="PmCopy" Header="IP 주소 복사" Click="PmCopy_Click"/>
                        <Separator/>
                        <MenuItem x:Name="PmRemove" Header="목록에서 삭제" Click="PmRemove_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
            <StackPanel Grid.Row="1" x:Name="PeersEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0,32,40" Visibility="Collapsed">
                <TextBlock x:Name="PeersEmptyTitle" Text="같은 네트워크의 동료를 찾는 중" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="PeersEmptyBody" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource Caption}" Margin="0,6,0,14" LineHeight="18"
                           Text="상대 PC에서도 파란전화기가 실행 중이어야 합니다. 다른 대역의 PC는 설정에서 IP를 직접 추가하세요."/>
                <Button Style="{StaticResource Outline}" Content="다시 찾기" HorizontalAlignment="Center" Click="Rescan_Click"/>
            </StackPanel>
        </Grid>

        <!-- history -->
        <Grid Grid.Row="4" x:Name="HistoryPane" Visibility="Collapsed">
            <ListBox x:Name="HistoryList" IsSynchronizedWithCurrentItem="False" Style="{StaticResource FlatList}" ItemTemplate="{StaticResource MsgTpl}" SelectionMode="Extended"
                     Padding="0,6,0,8" MouseDoubleClick="HistoryList_DoubleClick" SelectionChanged="HistoryList_SelectionChanged" KeyDown="HistoryList_KeyDown"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="열기" Click="HmOpen_Click" FontWeight="SemiBold"/>
                        <MenuItem Header="답장" Click="HmReply_Click"/>
                        <MenuItem Header="대화 보기" Click="HmChat_Click"/>
                        <MenuItem Header="예약 취소" Click="HmCancel_Click"/>
                        <MenuItem Header="내용 복사" Click="HmCopy_Click"/>
                        <Separator/>
                        <MenuItem Header="삭제" Click="HmDelete_Click" InputGestureText="Del"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
            <StackPanel x:Name="HistoryEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40" Visibility="Collapsed">
                <TextBlock Text="주고받은 쪽지가 여기에 쌓여요" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- actions -->
        <Border Grid.Row="5" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,10,12,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ComposeBtn" Style="{StaticResource Primary}" Height="36" Click="Compose_Click" HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE724;" FontFamily="{StaticResource Glyph}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0"/>
                        <TextBlock x:Name="ComposeText" Text="쪽지 보내기" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource Outline}" Height="36" Margin="8,0,0,0" Padding="14,0" Click="Broadcast_Click"
                        ToolTip="접속 중인 모든 동료에게 보냅니다" Content="전체 공지"/>
            </Grid>
        </Border>
    </Grid>
</Window>
