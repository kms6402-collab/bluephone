<Window x:Class="BluePhone.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BluePhone"
        Title="대화" Width="420" Height="600" MinWidth="340" MinHeight="380" AllowDrop="True">
    <Window.Resources>
        <local:BoolToVis x:Key="Vis"/>

        <DataTemplate x:Key="FileTpl" DataType="{x:Type local:FileItem}">
            <Border x:Name="fb" Background="{DynamicResource Ct.FileBg}" CornerRadius="8" Padding="10,7,6,7" Margin="0,6,0,0" MinWidth="200">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Name}"/>
                        <StackPanel Orientation="Horizontal" Opacity="0.75">
                            <TextBlock Text="{Binding SizeText}" FontSize="11.5"/>
                            <TextBlock Text="{Binding State}" FontSize="11.5" Margin="6,0,0,0"/>
                        </StackPanel>
                        <ProgressBar x:Name="bar" Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="3" Margin="0,4,0,0" BorderThickness="0"
                                     Background="#22000000" Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button x:Name="act" Style="{StaticResource Outline}" Height="26" Padding="9,0" Content="받기" Tag="{Binding}" Click="FileAction_Click"/>
                        <Button x:Name="folder" Style="{StaticResource Outline}" Height="26" Width="28" Padding="0" Margin="4,0,0,0" Tag="{Binding}"
                                Click="FileFolder_Click" Visibility="Collapsed" ToolTip="폴더에서 보기">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource Ink2}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="받는 중">
                    <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="act" Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="완료">
                    <Setter TargetName="act" Property="Content" Value="열기"/>
                    <Setter TargetName="folder" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="실패">
                    <Setter TargetName="act" Property="Content" Value="다시"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="보낸 파일">
                    <Setter TargetName="act" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="folder" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="fb" Property="Background" Value="#26FFFFFF"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="BubbleTpl" DataType="{x:Type local:ChatMessage}">
            <Grid Margin="14,3,14,3" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="av" Width="30" Height="30" VerticalAlignment="Top" Margin="0,2,8,0">
                    <Ellipse Fill="{Binding AvatarBrush}"/>
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse><Ellipse.Fill><ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                </Grid>
                <StackPanel x:Name="col" Grid.Column="1" HorizontalAlignment="Left">
                    <StackPanel x:Name="tags" Orientation="Horizontal" Margin="2,0,0,3">
                        <Border Background="{StaticResource DangerSoft}" CornerRadius="4" Padding="5,0" Margin="0,0,4,0"
                                Visibility="{Binding Urgent, Converter={StaticResource Vis}}">
                            <TextBlock Text="긴급" Foreground="{StaticResource Danger}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="{StaticResource Hover}" CornerRadius="4" Padding="5,0" Margin="0,0,4,0"
                                Visibility="{Binding IsNote, Converter={StaticResource Vis}}" ToolTip="쪽지 창으로 주고받은 쪽지">
                            <TextBlock Text="쪽지" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock x:Name="grp" FontSize="11" Foreground="{StaticResource Faint}" Text="{Binding Who, StringFormat='여러 명에게 · {0}'}" Visibility="Collapsed"/>
                    </StackPanel>
                    <Border x:Name="bubble" Background="{DynamicResource Ct.In}" TextElement.Foreground="{DynamicResource Ct.InText}"
                            CornerRadius="14,14,14,4" Padding="12,8" MaxWidth="300" HorizontalAlignment="Left">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="복사" Click="Copy_Click"/>
                                <MenuItem Header="다시 알림 (30분 후)" Click="Remind_Click"/>
                                <MenuItem Header="예약 취소" Click="CancelSchedule_Click"/>
                                <Separator/>
                                <MenuItem Header="삭제" Click="Delete_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel>
                            <TextBlock x:Name="txt" local:Emoji.Text="{Binding Text}" TextWrapping="Wrap"
                                       FontSize="{DynamicResource Ct.Size}" FontFamily="{DynamicResource Ct.Font}"
                                       Visibility="{Binding Text, Converter={StaticResource Vis}}"/>
                            <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FileTpl}" Focusable="False"/>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="metaRow" Orientation="Horizontal" Margin="4,3,4,0" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource Ct.Meta}"/>
                        <TextBlock x:Name="meta" Text="{Binding Meta, StringFormat=' · {0}'}" FontSize="11" Foreground="{DynamicResource Ct.Meta}"
                                   Visibility="{Binding Meta, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Outgoing}" Value="True">
                    <Setter TargetName="av" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="col" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="bubble" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="bubble" Property="Background" Value="{DynamicResource Ct.Out}"/>
                    <Setter TargetName="bubble" Property="CornerRadius" Value="14,14,4,14"/>
                    <Setter TargetName="bubble" Property="TextElement.Foreground" Value="{DynamicResource Ct.OutText}"/>
                    <Setter TargetName="metaRow" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="tags" Property="HorizontalAlignment" Value="Right"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPending}" Value="True">
                    <Setter TargetName="bubble" Property="Opacity" Value="0.6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                    <Setter TargetName="meta" Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ThemedChip" TargetType="ToggleButton" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="{DynamicResource Ct.InputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Ct.InputLine}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ct.Sub}"/>
        </Style>

        <Style x:Key="BubbleItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Ct.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border BorderBrush="{DynamicResource Ct.Line}" BorderThickness="0,0,0,1" Background="{DynamicResource Ct.Panel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="34" Height="34" Margin="16,0,10,0">
                    <Ellipse x:Name="HAvatar"/>
                    <TextBlock x:Name="HInitial" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse><Ellipse.Fill><ImageBrush x:Name="HPhoto" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                    <Ellipse Width="11" Height="11" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"/>
                    <Ellipse x:Name="HDot" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HName" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ct.Text}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <TextBlock x:Name="HStatus" Style="{StaticResource Caption}" Foreground="{DynamicResource Ct.Sub}"/>
                        <StackPanel x:Name="HSecure" Orientation="Horizontal" Margin="8,0,0,0" Visibility="Collapsed"
                                    ToolTip="이 동료와의 쪽지·파일은 암호화되어 전송됩니다 (ECDH P-256 + AES-256)">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Glyph}" FontSize="10.5" Foreground="#1FA971" VerticalAlignment="Center"/>
                            <TextBlock Text="암호화" Style="{StaticResource Caption}" Margin="3,0,0,0" Foreground="{DynamicResource Ct.Sub}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="LookBtn" Style="{StaticResource Chrome}" Content="&#xE790;" FontSize="13" ToolTip="대화 창 꾸미기 — 테마 · 글꼴 · 글자 크기" Click="Look_Click" Foreground="{DynamicResource Ct.Sub}"/>
                    <Button Style="{StaticResource Chrome}" Content="&#xE718;" FontSize="12" ToolTip="항상 위에" Click="Pin_Click" x:Name="PinBtn" Foreground="{DynamicResource Ct.Sub}"/>
                    <Button Style="{StaticResource Chrome}" Content="&#xE921;" Click="Min_Click" Foreground="{DynamicResource Ct.Sub}"/>
                    <Button Style="{StaticResource ChromeClose}" Content="&#xE8BB;" Click="Close_Click" Foreground="{DynamicResource Ct.Sub}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ListBox x:Name="List" Grid.Row="1" ItemTemplate="{StaticResource BubbleTpl}" ItemContainerStyle="{StaticResource BubbleItem}"
                 BorderThickness="0" Background="{DynamicResource Ct.Bg}" Padding="0,10,0,10"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" IsSynchronizedWithCurrentItem="False"/>
        <TextBlock x:Name="Empty" Grid.Row="1" Text="아직 주고받은 대화가 없어요" Style="{StaticResource Caption}" Foreground="{DynamicResource Ct.Sub}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- composer -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Ct.Line}" BorderThickness="0,1,0,0" Padding="12,10,12,12" Background="{DynamicResource Ct.Panel}">
            <StackPanel>
                <ItemsControl x:Name="FileList" Focusable="False" Margin="0,0,0,6" TextElement.Foreground="{DynamicResource Ct.Text}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Ct.InputLine}" BorderThickness="1" CornerRadius="6" Height="28" Padding="8,0,2,0" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource Icon}" Width="22" Height="22" FontSize="8" Content="&#xE8BB;" Tag="{Binding}" Click="RemoveFile_Click" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="ScheduleBar" Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="10,5,4,5" Margin="0,0,0,8" Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Icon}" Width="22" Height="22" FontSize="8" Content="&#xE8BB;" Click="ClearSchedule_Click"/>
                        <TextBlock x:Name="ScheduleText" Foreground="{StaticResource Accent}" VerticalAlignment="Center" FontSize="12.5"/>
                    </DockPanel>
                </Border>
                <TextBox x:Name="Input" Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="160"
                         Background="{DynamicResource Ct.InputBg}" Foreground="{DynamicResource Ct.Text}" BorderBrush="{DynamicResource Ct.InputLine}"
                         FontFamily="{DynamicResource Ct.Font}" FontSize="{DynamicResource Ct.Size}"
                         VerticalContentAlignment="Top" Padding="10,9" VerticalScrollBarVisibility="Auto" PreviewKeyDown="Input_PreviewKeyDown"/>
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Left" x:Name="EmojiBtn" Style="{StaticResource Icon}" Content="&#xE76E;" FontSize="15" ToolTip="이모지 · 이모티콘" Click="Emoji_Click" Foreground="{DynamicResource Ct.Sub}"/>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Icon}" Content="&#xE723;" FontSize="15" ToolTip="파일 · 폴더 첨부" Click="Attach_Click" Foreground="{DynamicResource Ct.Sub}"/>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Icon}" Content="&#xE8C6;" FontSize="15" ToolTip="화면 캡처 (Ctrl+Alt+S)" Click="Capture_Click" x:Name="CaptureBtn" Foreground="{DynamicResource Ct.Sub}"/>
                    <Button DockPanel.Dock="Left" x:Name="ScheduleBtn" Style="{StaticResource Icon}" Content="&#xE823;" FontSize="15" ToolTip="예약 보내기" Click="Schedule_Click" Foreground="{DynamicResource Ct.Sub}"/>
                    <ToggleButton x:Name="Urgent" DockPanel.Dock="Left" Style="{StaticResource ThemedChip}" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="긴급" FontSize="12.5"/>
                    </ToggleButton>
                    <Button x:Name="SendBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Height="32" Padding="16,0" Click="Send_Click">
                        <TextBlock x:Name="SendText" Text="보내기"/>
                    </Button>
                    <TextBlock x:Name="Hint" Foreground="{DynamicResource Ct.Meta}" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border x:Name="DropOverlay" Grid.RowSpan="3" Background="#E6F3F6FE" BorderBrush="{StaticResource Accent}" BorderThickness="1.5" Margin="8"
                CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="여기에 놓으면 첨부됩니다" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
