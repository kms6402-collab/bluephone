<Window x:Class="BluePhone.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BluePhone"
        Title="새 쪽지" Width="460" Height="440" MinWidth="360" MinHeight="300" AllowDrop="True"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource Chrome}" Content="&#xE921;" Click="Min_Click"/>
                <Button Style="{StaticResource ChromeClose}" Content="&#xE8BB;" Click="Close_Click"/>
            </StackPanel>
            <TextBlock x:Name="Heading" Text="새 쪽지" FontWeight="SemiBold" Margin="18,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- recipients -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,4,12,8">
            <DockPanel>
                <TextBlock Text="받는 사람" Style="{StaticResource Caption}" VerticalAlignment="Top" Margin="0,6,12,0" DockPanel.Dock="Left"/>
                <WrapPanel x:Name="Chips" VerticalAlignment="Center">
                    <ItemsControl x:Name="ToList" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:Peer}">
                                <Border Background="{StaticResource Canvas}" CornerRadius="12" Height="26" Padding="4,0,2,0" Margin="0,0,6,4"
                                        ToolTip="{Binding Address}">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                                            <Ellipse Fill="{Binding AvatarBrush}"/>
                                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Ellipse><Ellipse.Fill><ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                                        </Grid>
                                        <TextBlock Text="{Binding DisplayName}" Margin="6,0,2,0" VerticalAlignment="Center"/>
                                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" Margin="3,0,2,0" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource Icon}" Width="22" Height="22" FontSize="8" Content="&#xE8BB;" Tag="{Binding}"
                                                Click="RemoveTo_Click" ToolTip="빼기" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="BroadcastInfo" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,5,8,4" Foreground="{StaticResource Ink2}"/>
                    <Button x:Name="AddBtn" Style="{StaticResource BtnBase}" Height="26" Padding="8,0" Margin="0,0,0,4" Click="AddTo_Click"
                            Foreground="{StaticResource Accent}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Glyph}" FontSize="10" VerticalAlignment="Center" Margin="0,1,5,0"/>
                            <TextBlock Text="추가" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- quote -->
        <Border x:Name="QuoteBar" Grid.Row="2" Visibility="Collapsed" Margin="18,12,18,0" BorderBrush="{StaticResource LineStrong}" BorderThickness="2,0,0,0" Padding="10,2">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Icon}" Width="22" Height="22" FontSize="8" Content="&#xE8BB;" Click="DropQuote_Click" ToolTip="인용 빼기"/>
                <TextBlock x:Name="QuoteText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <TextBox x:Name="Body" Grid.Row="3" Style="{StaticResource BareArea}" Margin="18,14,14,8" Tag="내용을 입력하세요"
                 PreviewKeyDown="Body_PreviewKeyDown" SpellCheck.IsEnabled="False"/>

        <!-- attachments -->
        <ItemsControl x:Name="FileList" Grid.Row="4" Margin="16,0,16,6" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Height="30" Padding="8,0,2,0" Margin="0,0,6,6"
                            ToolTip="{Binding Path}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" MaxWidth="180" TextTrimming="CharacterEllipsis" Margin="6,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <Button Style="{StaticResource Icon}" Width="22" Height="22" FontSize="8" Content="&#xE8BB;" Tag="{Binding}" Click="RemoveFile_Click" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- footer -->
        <Border Grid.Row="5" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,10,12,12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource Icon}" Content="&#xE723;" FontSize="15" ToolTip="파일 첨부 — 모든 형식 · 폴더는 자동 압축 (끌어다 놓기, Ctrl+V 도 가능)" Click="Attach_Click"/>
                <ToggleButton x:Name="Urgent" DockPanel.Dock="Left" Style="{StaticResource Chip}" Margin="6,0,0,0" VerticalAlignment="Center"
                              ToolTip="받는 사람이 방해 금지 상태여도 알림이 뜨고, 창이 깜박입니다">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Glyph}" FontSize="11" VerticalAlignment="Center" Margin="0,1,5,0"/>
                        <TextBlock Text="긴급" FontSize="12.5"/>
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="SendBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}" Height="34" Padding="18,0" Click="Send_Click" MinWidth="92">
                    <TextBlock x:Name="SendText" Text="보내기"/>
                </Button>
                <TextBlock x:Name="Hint" Text="Ctrl+Enter" Foreground="{StaticResource Faint}" FontSize="11.5" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- drop overlay -->
        <Border x:Name="DropOverlay" Grid.RowSpan="6" Background="#E6F3F6FE" BorderBrush="{StaticResource Accent}" BorderThickness="1.5" Margin="8"
                CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="여기에 놓으면 첨부됩니다" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
